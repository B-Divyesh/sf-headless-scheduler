{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin",
    "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/manifest.webmanifest", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/", "headers": { "Cache-Control": "no-store" } },
    { "route": "/index.html", "headers": { "Cache-Control": "no-store" } },
    { "route": "/offline.html", "headers": { "Cache-Control": "no-store" } },
    { "route": "/404.html", "headers": { "Cache-Control": "no-store" } },
    { "route": "/demo", "rewrite": "/demo/index.html", "headers": { "Cache-Control": "no-store" } },
    { "route": "/privacy", "rewrite": "/privacy/index.html", "headers": { "Cache-Control": "no-store" } },
    { "route": "/terms", "rewrite": "/terms/index.html", "headers": { "Cache-Control": "no-store" } },
    { "route": "/privacy/*", "headers": { "Cache-Control": "no-store" } },
    { "route": "/terms/*", "headers": { "Cache-Control": "no-store" } },
    { "route": "/favicon.svg" },
    { "route": "/apple-touch-icon.png" },
    { "route": "/icon-192.svg" },
    { "route": "/icon-512.svg" },
    { "route": "/robots.txt" },
    { "route": "/sitemap.xml" },
    { "route": "/riso-scheduler.webp" },
    { "route": "/riso-scheduler.webp.json" },
    { "route": "/og-headless-scheduler.webp" },
    { "route": "/headless-scheduler-0.1.0.tgz" },
    { "route": "/*", "rewrite": "/404.html", "statusCode": 404, "headers": { "Cache-Control": "no-store" } }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/assets/*", "/sw.js", "/manifest.webmanifest", "/favicon.svg", "/apple-touch-icon.png", "/icon-192.svg", "/icon-512.svg", "/demo*", "/privacy*", "/terms*", "/offline.html", "/robots.txt", "/sitemap.xml", "/riso-scheduler.webp", "/og-headless-scheduler.webp", "/headless-scheduler-0.1.0.tgz"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  }
}
