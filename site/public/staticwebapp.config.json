{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin",
    "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/manifest.webmanifest", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/", "headers": { "Cache-Control": "no-store" } },
    { "route": "/index.html", "headers": { "Cache-Control": "no-store" } },
    { "route": "/offline.html", "headers": { "Cache-Control": "no-store" } },
    { "route": "/privacy/*", "headers": { "Cache-Control": "no-store" } },
    { "route": "/terms/*", "headers": { "Cache-Control": "no-store" } },
    { "route": "/*", "headers": { "Cache-Control": "no-store" } }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/sw.js", "/manifest.webmanifest", "/favicon.svg", "/icon-192.svg", "/icon-512.svg", "/privacy/*", "/terms/*", "/offline.html", "/robots.txt", "/sitemap.xml", "/riso-scheduler.webp"]
  }
}
