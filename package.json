{
  "name": "headless-scheduler",
  "version": "0.1.0",
  "description": "Headless TypeScript calendar and free resource timeline primitives",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/package",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/package/index.cjs",
  "module": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js",
      "require": "./dist/package/index.cjs"
    },
    "./react": {
      "types": "./dist/package/react.d.ts",
      "import": "./dist/package/react.js",
      "require": "./dist/package/react.cjs"
    },
    "./preset.css": "./dist/package/preset.css"
  },
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "build": "npm run build:lib && npm run build:site",
    "build:lib": "vite build --config vite.config.ts && tsc -p tsconfig.build.json && cp src/preset.css dist/package/preset.css",
    "build:site": "npm run build:lib && vite build --config site/vite.config.ts && node scripts/prepare-site.mjs && node scripts/build-service-worker.mjs",
    "prepack": "npm run build:lib",
    "check": "tsc --noEmit && tsc -p site/tsconfig.json --noEmit",
    "check:claims": "node scripts/check-claims.mjs",
    "check:a11y": "node scripts/a11y.mjs",
    "check:visual": "node scripts/capture-evidence.mjs",
    "check:smoke": "node scripts/smoke.mjs",
    "check:pack": "node scripts/pack-consumer.mjs",
    "check:headers": "node scripts/site-headers.mjs",
    "check:offline": "node scripts/pwa-offline.mjs",
    "check:pwa-update": "node scripts/pwa-update.mjs",
    "test:claims": "npm run check:claims && npm run build && playwright test --config playwright.config.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "preact": "^10.29.8",
    "@playwright/test": "1.58.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/B-Divyesh/sf-headless-scheduler.git"
  },
  "keywords": [
    "calendar",
    "scheduler",
    "resource-timeline",
    "headless",
    "tailwind",
    "react"
  ]
}
